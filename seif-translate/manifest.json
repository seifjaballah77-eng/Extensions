{
  "manifest_version": 3,
  "name": "Seif Translate",
  "version": "2.0.0",
  "description": "ترجمة ذكية للنصوص وصفحات الويب داخل الصفحة نفسها.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Seif Translate",
    "default_popup": "popup.html"
  }
}